# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
tab_width = 4
trim_trailing_whitespace = true

# Configuration/data files
[*.{json,yml,yaml,properties}]
indent_size = 2
max_line_length = off

# Documentation
[*.{md,adoc}]
indent_style = unset
indent_size = unset
max_line_length = off
trim_trailing_whitespace = false
